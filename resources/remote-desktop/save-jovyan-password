#!/bin/sh
# Run by pam_exec (see /etc/pam.d/common-password) after a password change. Saves jovyan's password hash on the
# home volume; start-remote-desktop.sh restores it on the next start, because /etc/shadow is reset with the
# container. The file is written as jovyan, so this also works where the volume does not let root write
# (NFS with root_squash).
[ "$PAM_USER" = jovyan ] || exit 0
hash=$(getent shadow jovyan | cut -d: -f2)
[ -n "$hash" ] || exit 0
printf '%s\n' "$hash" | runuser -u jovyan -- sh -c \
  'umask 077 && cat > /home/jovyan/.password-hash.tmp && mv -f /home/jovyan/.password-hash.tmp /home/jovyan/.password-hash'
